# Copy to install.env and edit values before running the installer.
# Quote any values with spaces: KEY="value with spaces"

# Domain + URL
DOMAIN=swagcuts.com
# If you access the site from another device, set WP_URL to the VM IP.
WP_URL=http://127.0.0.1
DEV_HOSTS="127.0.0.1 localhost"
NGINX_CLIENT_MAX_BODY_SIZE=64M

# Install path
SITE_ROOT=/var/www/swagcuts

# Database
DB_NAME=swagcuts_wp
DB_USER=admin
DB_PASS=q1w2e3r4

# WordPress admin account
WP_TITLE="Swag Cuts Grooming"
WP_ADMIN_USER=admin
WP_ADMIN_PASS=q1w2e3r4
WP_ADMIN_EMAIL=you@example.com
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
DISALLOW_FILE_EDIT=true
WP_FS_METHOD=

# PHP limits
PHP_MAX_EXECUTION_TIME=600
PHP_MAX_INPUT_TIME=600
PHP_MEMORY_LIMIT=256M
PHP_POST_MAX_SIZE=32M
PHP_UPLOAD_MAX_FILESIZE=32M
PHP_MAX_INPUT_VARS=3000

# Let's Encrypt
ENABLE_SSL=no
LE_EMAIL=you@example.com

# Theme zips (optional). Upload these to your VM and set the paths.
THEME_ZIP_PATH="/home/lorenzo/Documents/swagcuts/themeforest-l81IYn6v-pet-grooming-pet-shop-veterinary-theme/Pets Grooming_v2.0/pets-grooming.zip"
CHILD_THEME_ZIP_PATH="/home/lorenzo/Documents/swagcuts/themeforest-l81IYn6v-pet-grooming-pet-shop-veterinary-theme/Pets Grooming_v2.0/pets-grooming-child.zip"
TRX_ADDONS_ZIP_PATH=/home/ubuntu/trx_addons.zip
THEMEREX_UPDATER_ZIP_PATH=/home/ubuntu/themerex-updater.zip

# Optional plugin installs
INSTALL_TRX_ADDONS=yes

# Optional plugin slugs to install (space-separated)
# Example: PLUGINS_TO_INSTALL="woocommerce elementor wp-mail-smtp"
PLUGINS_TO_INSTALL="woocommerce elementor wp-mail-smtp"
