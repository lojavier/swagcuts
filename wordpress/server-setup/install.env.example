# Copy to install.env and edit values before running the installer.
# Quote any values with spaces: KEY="value with spaces"

# Domain + URL
DOMAIN=swagcuts.com
# If you access the site from another device, set WP_URL to the VM IP.
WP_URL=http://127.0.0.1
DEV_HOSTS="127.0.0.1 localhost"
NGINX_CLIENT_MAX_BODY_SIZE=64M

# Optional static IP config (used by set_static_ip.sh)
STATIC_CONN=static-eth
STATIC_IFACE=enp0s3
STATIC_IP=127.0.0.1
STATIC_PREFIX=24
STATIC_GATEWAY=127.0.0.1
STATIC_DNS=1.1.1.1

# Install path
SITE_ROOT=/var/www/swagcuts

# Database
DB_NAME=swagcuts_wp
DB_USER=admin
DB_PASS=q1w2e3r4
DB_ROOT_USER=root
DB_ROOT_PASS=

# WordPress admin account
WP_TITLE="Swag Cuts Grooming"
WP_ADMIN_USER=admin
WP_ADMIN_PASS=q1w2e3r4
WP_ADMIN_EMAIL=you@example.com
WP_MEMORY_LIMIT=512M
WP_MAX_MEMORY_LIMIT=512M
DISALLOW_FILE_EDIT=true
WP_FS_METHOD=

# PHP limits
PHP_MAX_EXECUTION_TIME=600
PHP_MAX_INPUT_TIME=600
PHP_MEMORY_LIMIT=512M
PHP_POST_MAX_SIZE=32M
PHP_UPLOAD_MAX_FILESIZE=32M
PHP_MAX_INPUT_VARS=3000
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=128
PHP_OPCACHE_MAX_ACCELERATED_FILES=10000
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
PHP_OPCACHE_REVALIDATE_FREQ=2

# Optional baseline setup
SET_TIMEZONE=America/Los_Angeles
ENABLE_UFW=no
UFW_SSH_PORT=22
ENABLE_FAIL2BAN=no
ENABLE_UNATTENDED_UPGRADES=no
SKIP_APT_UPGRADE=no
INSTALL_GUEST_ADDITIONS_DEPS=no
GUEST_ADDITIONS_INSTALLER_PATH="/media/lorenzo/VBox_GAs_7.2.4/VBoxLinuxAdditions.run"
GUEST_ADDITIONS_INSTALLER_ARGS=
SWAP_SIZE=
SWAP_PATH=/swapfile
RUN_MYSQL_SECURE_INSTALLATION=no

# Cleanup options (used by cleanup_wordpress.sh)
REMOVE_SITE=yes
REMOVE_DB=yes
REMOVE_NGINX=yes
DB_ROOT_USER=root
DB_ROOT_PASS=
DRY_RUN=no
BACKUP_BEFORE_CLEANUP=no
BACKUP_DIR=/var/backups/swagcuts
BACKUP_DB=yes
BACKUP_SITE=yes
BACKUP_SITE_PATH=/var/www/swagcuts/wp-content

# Let's Encrypt
ENABLE_SSL=no
LE_EMAIL=you@example.com
NGINX_FASTCGI_READ_TIMEOUT=300
NGINX_FASTCGI_SEND_TIMEOUT=300

# Theme zips (optional). Upload these to your VM and set the paths.
THEME_ZIP_PATH="/home/lorenzo/Documents/swagcuts/themeforest-l81IYn6v-pet-grooming-pet-shop-veterinary-theme/Pets Grooming_v2.0/pets-grooming.zip"
CHILD_THEME_ZIP_PATH="/home/lorenzo/Documents/swagcuts/themeforest-l81IYn6v-pet-grooming-pet-shop-veterinary-theme/Pets Grooming_v2.0/pets-grooming-child.zip"
THEME_SLUG=pets-grooming
CHILD_THEME_SLUG=pets-grooming-child
TRX_ADDONS_ZIP_PATH="/home/lorenzo/Documents/swagcuts/trx_addons.zip"
THEMEREX_UPDATER_ZIP_PATH="/home/lorenzo/Documents/swagcuts/trx_updater.zip"
AUTO_FIND_BUNDLED_PLUGINS=yes
UPDATE_THEME_ON_INSTALL=no

# Optional plugin installs
INSTALL_TRX_ADDONS=yes
PLUGIN_INSTALL_RETRIES=2

# Optional plugin slugs to install (space-separated)
# Example: PLUGINS_TO_INSTALL="woocommerce elementor metform wp-mail-smtp"
PLUGINS_TO_INSTALL="woocommerce elementor metform wp-mail-smtp"
